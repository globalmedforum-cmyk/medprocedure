generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ProcedureStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  name      String?
  specialty String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  progress  UserProcedureProgress[]

  @@map("users")
}

model Procedure {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String   @db.Text
  country     String
  category    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  steps       Step[]
  progress    UserProcedureProgress[]

  @@map("procedures")
}

model Step {
  id                String    @id @default(cuid())
  procedureId       String
  procedure         Procedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  order             Int
  title             String
  description       String    @db.Text
  content           String?   @db.Text
  estimatedDuration String?
  isRequired        Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([procedureId, order])
  @@map("steps")
}

model UserProcedureProgress {
  id               String          @id @default(cuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  procedureId      String
  procedure        Procedure       @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  status           ProcedureStatus @default(NOT_STARTED)
  completedStepIds String[]        @default([])
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([userId, procedureId])
  @@map("user_procedure_progress")
}

model Opportunity {
  id           String    @id @default(cuid())
  title        String
  hospital     String
  location     String
  country      String
  specialty    String
  deadline     DateTime?
  requirements String[]  @default([])
  contactEmail String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("opportunities")
}
