generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ProcedureStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum OpportunityCategory {
  FFI
  STAGE_ASSOCIE
  MEDECIN_ASSISTANT
  FELLOWSHIP
  PHD
  CONGRES
}

model User {
  id              String    @id @default(cuid())
  clerkId         String    @unique
  email           String    @unique
  name            String?
  specialty       String?
  // Version des conditions générales acceptée, et date d'acceptation
  termsVersion    String?
  termsAcceptedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  progress UserProcedureProgress[]

  @@map("users")
}

model Procedure {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String   @db.Text
  country     String
  category    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  steps    Step[]
  progress UserProcedureProgress[]

  @@map("procedures")
}

model Step {
  id                String    @id @default(cuid())
  procedureId       String
  procedure         Procedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  order             Int
  title             String
  description       String    @db.Text
  content           String?   @db.Text
  videoUrl          String?
  estimatedDuration String?
  isRequired        Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([procedureId, order])
  @@map("steps")
}

// Un dossier : une démarche suivie par un utilisateur. Un utilisateur peut
// ouvrir plusieurs dossiers pour une même procédure (deux congrès, plusieurs
// candidatures…), chacun avec son propre avancement.
model UserProcedureProgress {
  id               String          @id @default(cuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  procedureId      String
  procedure        Procedure       @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  label            String          @default("")
  targetDate       DateTime?
  status           ProcedureStatus @default(NOT_STARTED)
  completedStepIds String[]        @default([])
  // Congrès choisi avec « Participer à cet événement » : le guide s'y adapte
  opportunityId    String?
  opportunity      Opportunity?    @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([userId, procedureId])
  @@index([opportunityId])
  @@map("user_procedure_progress")
}

model Opportunity {
  id           String              @id @default(cuid())
  category     OpportunityCategory
  title        String
  hospital     String
  location     String
  country      String
  specialty    String
  deadline     DateTime?
  requirements String[]            @default([])
  contactEmail String?
  // Publiée en entier (établissement, conditions et liens visibles par tous),
  // comme les congrès, au lieu du seul aperçu
  isPublic     Boolean             @default(false)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  dossiers UserProcedureProgress[]

  @@index([category])
  @@map("opportunities")
}
